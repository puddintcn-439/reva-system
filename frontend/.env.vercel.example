# ─────────────────────────────────────────────────────────
# Frontend environment variables — Vercel production
# ─────────────────────────────────────────────────────────
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables

# URL của backend Vercel deployment (không có trailing slash)
# Lấy sau khi deploy backend xong
VITE_API_URL=https://your-backend.vercel.app

# Sentry DSN (optional — lấy từ sentry.io → Project → Settings → Client Keys)
VITE_SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
