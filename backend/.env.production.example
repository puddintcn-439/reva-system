# ============================================================
# R.E.V.A Backend — Production Environment Variables
# Copy this file to .env.production and fill in the values.
# Never commit .env.production to source control.
# ============================================================

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# Option A: single connection string (Supabase / Railway / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B: individual vars (use when password contains special characters)
# PGHOST=your-db-host
# PGPORT=5432
# PGDATABASE=hun_consignment
# PGUSER=postgres
# PGPASSWORD=your-db-password

# ── Auth ─────────────────────────────────────────────────────
# Must be a long random string (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
# ── Auth ─────────────────────────────────────────────────────
# JWT signing secret — REQUIRED in production (set in Vercel / Docker secrets)
# Example placeholder (do NOT commit real secrets). Set on Vercel instead.
JWT_SECRET=<provide-a-secure-random-secret>
# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=https://your-frontend-domain.vercel.app

# ── Email / SMTP ─────────────────────────────────────────────
# Can also be set via Admin → Settings in the UI (stored in system_settings table)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=REVA <your-email@gmail.com>

# ── Supabase Storage (for image uploads) ─────────────────────
# SUPABASE_URL:         Project URL, e.g. https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY: service_role secret key (Settings → API)
# SUPABASE_BUCKET:      Storage bucket name (default: products)
#
# Setup: Supabase dashboard → Storage → New bucket "products" → Public
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key
SUPABASE_BUCKET=products
